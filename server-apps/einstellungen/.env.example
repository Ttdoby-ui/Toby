# Kopie als .env anlegen, chmod 600, Besitzer futurespin. NICHT ins Git.
SHOPIFY_STORE_DOMAIN=e7ee88-2.myshopify.com

# Empfohlen: Zugangsdaten der App "VIP Belaege Discount".
# Damit sind spaeter auch Mutationen moeglich, die nur die besitzende App darf
# (Rabatt aktivieren/pausieren, combinesWith).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Alternative: fertiger Admin-Token mit write_discounts.
# Reicht fuer das Config-Metafeld, nicht fuer die App-eigenen Mutationen.
# SHOPIFY_ACCESS_TOKEN=

EINSTELLUNGEN_PASSWORT=
FLASK_SECRET_KEY=
PORT=5001
