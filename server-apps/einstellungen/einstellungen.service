[Unit]
Description=Futurespin Einstellungen (Shopify-Konfiguration)
After=network.target

[Service]
Type=simple
User=futurespin
Group=futurespin
WorkingDirectory=/home/futurespin/einstellungen
EnvironmentFile=/home/futurespin/einstellungen/.env
ExecStart=/home/futurespin/einstellungen/.venv/bin/gunicorn \
    --workers 2 --bind 127.0.0.1:5001 --timeout 60 app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
